    {
      "parameters": {
        "jsCode": "const row = $('Mark Executed').first().json;\nconst campaignSfId = row.salesforce_campaign_id || '';\nif (!campaignSfId) return [];\n\nlet brief = row.raw_payload;\nif (typeof brief === 'string') { try { brief = JSON.parse(brief); } catch (e) { brief = null; } }\nconst buyingGroup = (brief && Array.isArray(brief.buying_group)) ? brief.buying_group : [];\nconst account = (row.account || '').trim();\n\nconst confirmed = buyingGroup.filter(c => c && c.status === 'CONFIRMED' && typeof c.name === 'string' && c.name.trim());\n\nreturn confirmed.map(c => {\n  const parts = c.name.trim().split(/\\s+/);\n  let firstname = '', lastname = '';\n  if (parts.length > 1) {\n    lastname = parts.pop();\n    firstname = parts.join(' ');\n  } else {\n    lastname = parts[0] || '';\n  }\n  return { json: {\n    firstname, lastname, company: account,\n    title: c.title || '', focus_area: c.focus_area || '',\n    campaign_salesforce_id: campaignSfId\n  }};\n});"
      },
