    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst SECRET = $('Get HMAC Secret').first().json.value;\nfunction sign(id, action) {\n  return crypto.createHmac('sha256', SECRET).update(`action:${id}:${action}`).digest('hex').slice(0, 32);\n}\nconst q = ($('Webhook (approve/reject)').item.json.query) || {};\nconst id = q.id;\nconst action = q.action;\nconst sig = q.sig || '';\nconst rawReason = q.reason || '';\nconst reason = String(rawReason).replace(/[^a-zA-Z0-9 _-]/g, '').slice(0, 100);\n// src is metadata only (not part of the signature): 'auto' marks approvals fired\n// by the Cadence Scheduler's campaign-level auto-execution, so the per-action\n// rep email can be suppressed (the daily digest already carries the draft).\nconst src = q.src === 'auto' ? 'auto' : '';\nconst idOk = typeof id === 'string' && /^[0-9]+$/.test(id);\nconst actionOk = action === 'approve' || action === 'reject';\nlet sigOk = false;\nif (idOk && actionOk) {\n  const expected = sign(id, action);\n  const a = Buffer.from(String(sig));\n  const b = Buffer.from(expected);\n  sigOk = a.length === b.length && crypto.timingSafeEqual(a, b);\n}\nconst valid = idOk && actionOk && sigOk;\nreturn [{ json: { valid, query: { id: idOk ? id : '', action: actionOk ? action : '', reason, src } } }];"
      },
