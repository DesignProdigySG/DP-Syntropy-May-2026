    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE actions\nSET status = 'executed', executed_at = now(), decided_at = now()\nWHERE id = {{ $json.query.id }} AND status <> 'executed'\nRETURNING id, account, action_type, target, priority, reason, hypothesis, tracked_url, outreach_draft, campaign_id,\n  (select raw_payload from pipeline_runs where id = actions.run_id) as raw_payload,\n  (select salesforce_campaign_id from campaigns where id = actions.campaign_id) as salesforce_campaign_id,\n  coalesce(nullif((select c.rep_email from clients c where c.id = actions.client_id), ''), (select value from app_config where key='rep_notification_email')) as rep_email_resolved;",
        "options": {}
      },
