  {
   "id": "3e7804e3-389c-452e-9c6e-e70ba79be005",
   "name": "Build WHEN Feedback",
   "type": "n8n-nodes-base.code",
   "position": [
    624,
    112
   ],
   "parameters": {
    "jsCode": "const row = $json;\nlet brief = row.raw_payload;\nif (typeof brief === 'string') { try { brief = JSON.parse(brief); } catch (e) { brief = null; } }\nif (!brief || typeof brief !== 'object') {\n  brief = { meta:{ engine:'WHEN Layer Intelligence Engine', document_type:'account brief', schema_version:'1.1', export_date:new Date().toISOString().slice(0,10) }, account:{ name: row.account || 'unknown' }, signals:[], buying_group:[], human_signals:[] };\n}\nbrief.human_signals = Array.isArray(brief.human_signals) ? brief.human_signals : [];\nbrief.human_signals.push({ type:'human_rejection', gate:'action', reason: row.rejection_reason || 'rejected_by_human', routed_to: row.rejection_routed_to || 'engine_logic', rejected_at:new Date().toISOString(), source:'delivery_layer', action_id: row.id });\nreturn [{ json: { when_engine_url: row.when_engine_url || '', payload: brief } }];"
   },
   "typeVersion": 2
  },
