   "parameters": {
    "query": "SELECT COALESCE(SUM(value), 0) AS measured, COUNT(*) AS event_count\nFROM engagement_events\nWHERE (action_id = $1 OR campaign = $2)\n  AND occurred_at >= $3::timestamptz;",
