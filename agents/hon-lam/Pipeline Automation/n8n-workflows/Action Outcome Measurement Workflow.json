   "type": "n8n-nodes-base.gmail",
   "position": [
    992,
    208
   ],
   "webhookId": "f4029657-614a-41f9-ad33-a4ecb8963cec",
   "parameters": {
    "filters": {
     "q": "=\"{{ $('Loop Replies').first().json.utm_campaign }}\" after:{{ Math.floor(new Date($('Loop Replies').first().json.executed_at).getTime()/1000) }}"
    },
    "operation": "getAll",
    "returnAll": true
   },
   "credentials": {
    "gmailOAuth2": {
