   ],
   "parameters": {
    "jsCode": "const a = $('Get Due Actions').item.json;\nconst row = $json;\nconst measuredValue = Number(row.measured) || Number(row.event_count) || 0;\nconst met = a.predicted_direction === 'increase'\n  ? measuredValue >= Number(a.threshold)\n  : measuredValue <= Number(a.threshold);\nreturn [{ json: {\n  action_id:       a.id,\n  measured_metric: a.predicted_metric,\n  measured_value:  measuredValue,\n  result:          met ? 'met' : 'not_met',\n  source:          'engagement_events',\n  window_start:    a.executed_at,\n  window_end:      new Date().toISOString()\n}}];"
   },
