          }
        ]
      ]
    },
    "Split Items": {
      "main": [
        [
          {
            "node": "Approve Each",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
