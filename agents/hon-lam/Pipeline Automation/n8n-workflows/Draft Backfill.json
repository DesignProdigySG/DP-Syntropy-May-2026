{
  "name": "Draft Backfill",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "id": "350ab1ae-2466-4ff6-902a-2a6850089f8a",
      "name": "Every 2 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        80
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT 'cadence_steps' AS tbl, cs.id, cs.account, cs.action_type, cs.target, cs.reason, cs.hypothesis, cs.tracked_url,\n       coalesce(cs.funnel_stage, o.funnel_stage) AS funnel_stage, o.objective_key, pr.industry, pr.theme\nFROM cadence_steps cs\nJOIN campaigns c ON c.id = cs.campaign_id\nLEFT JOIN pipeline_runs pr ON pr.id = c.run_id\nLEFT JOIN campaign_objectives o ON o.campaign_id = cs.campaign_id\nWHERE cs.status = 'pending' AND (cs.outreach_draft IS NULL OR cs.outreach_draft = '')\nUNION ALL\nSELECT 'actions' AS tbl, a.id, a.account, a.action_type, a.target, a.reason, a.hypothesis, a.tracked_url,\n       coalesce(a.funnel_stage, o.funnel_stage) AS funnel_stage, o.objective_key, pr.industry, pr.theme\nFROM actions a\nLEFT JOIN pipeline_runs pr ON pr.id = a.run_id\nLEFT JOIN campaign_objectives o ON o.campaign_id = a.campaign_id\nWHERE a.status = 'recommended' AND (a.outreach_draft IS NULL OR a.outreach_draft = '')\nORDER BY 1\nLIMIT 25;",
        "options": {}
      },
      "id": "cf9e60c6-56b5-4b49-9f69-dd8e8500767c",
      "name": "Get Draftless Steps",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://designprodigy.app.n8n.cloud/webhook/generate-draft",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { 'action_type': $json.action_type, 'account': $json.account, 'industry': $json.industry, 'theme': $json.theme, 'target': $json.target, 'funnel_stage': $json.funnel_stage, 'objective': $json.objective_key, 'reason': $json.reason || $json.hypothesis, 'tracked_url': $json.tracked_url } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "783a15a9-0a56-42ce-b370-0b98cd2fb37e",
      "name": "Generate Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        672,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE {{ $('Draft Backfill Loop').item.json.tbl }} SET outreach_draft = $1 WHERE id = $2;",
        "options": {
          "queryReplacement": "={{ [$json.draft, $('Draft Backfill Loop').item.json.id] }}"
        }
      },
      "id": "a269ea8b-ffde-4410-baf4-50da9f5db1a4",
      "name": "Save Draft",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        896,
        80
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "abb4df39-0697-41c3-8442-a9b1e786a75c",
      "name": "Draft Backfill Loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        448,
        80
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "run-draft-backfill",
        "options": {}
      },
      "id": "c37055d9-8615-4ad9-bfd7-836295610caa",
      "name": "Backfill Now",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        240
      ],
      "webhookId": "a2c7bf93-d496-4e3a-a111-bad88c478d40"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        432
      ],
      "id": "277d5e36-5233-4198-a195-68c02505790d",
      "name": "When clicking ‘Execute workflow’"
    }
  ],
  "connections": {
    "Every 2 Hours": {
      "main": [
        [
          {
            "node": "Get Draftless Steps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Draftless Steps": {
      "main": [
        [
          {
            "node": "Draft Backfill Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Draft": {
      "main": [
        [
          {
            "node": "Save Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Draft": {
      "main": [
        [
          {
            "node": "Draft Backfill Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Draft Backfill Loop": {
      "main": [
        [],
        [
          {
            "node": "Generate Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backfill Now": {
      "main": [
        [
          {
            "node": "Get Draftless Steps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "When clicking ‘Execute workflow’": {
      "main": [
        [
          {
            "node": "Get Draftless Steps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
    "binaryMode": "separate",
    "timeSavedMode": "fixed",
    "errorWorkflow": "rVr68buB9TD3qR5Y",
    "callerPolicy": "workflowsFromSameOwner"
  }
}
