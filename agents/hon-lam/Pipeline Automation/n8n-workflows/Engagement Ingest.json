      "parameters": {
        "jsCode": "// Accepts BOTH: POST JSON body (quick-log, Calendly feeder, My Day widget)\n// and GET query params (one-click \"log outcome\" links in the daily digest).\nconst q = ($json.query && typeof $json.query === 'object') ? $json.query : {};\nconst hasBody = $json.body && typeof $json.body === 'object' && Object.keys($json.body).length > 0;\nconst b = hasBody ? $json.body : (Object.keys(q).length ? q : $json);\nlet metadata = null;\nif (b.metadata && typeof b.metadata === 'object') metadata = b.metadata;\nelse if (b.note) metadata = { note: String(b.note).slice(0, 300), logged_via: 'digest_link' };\nelse if (!hasBody && Object.keys(q).length) metadata = { logged_via: 'digest_link' };\nreturn [{ json: {\n  account: b.account || null,\n  contact: b.contact || null,\n  source: b.source || null,\n  event_type: b.event_type || null,\n  campaign: b.utm_campaign || b.campaign || null,\n  action_id: (b.action_id != null && b.action_id !== '' ? Number(b.action_id) : null),\n  value: (b.value != null && b.value !== '' ? Number(b.value) : (hasBody ? null : 1)),\n  occurred_at: b.occurred_at || new Date().toISOString(),\n  metadata\n} }];"
      }
    },
