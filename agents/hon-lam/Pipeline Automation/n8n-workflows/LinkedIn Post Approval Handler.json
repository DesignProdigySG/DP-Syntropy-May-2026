        "path": "linkedin-post-approval",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "4c3892c4-cca7-4c10-bdbf-02ec222d1853"
    },
    {
      "id": "3e7f1658-b7c7-4aa1-ba05-35b1d013d4a8",
      "name": "Get HMAC Secret",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select (select value from app_config where key='approval_hmac_secret') as value, (select value from app_config where key='rep_notification_email') as rep_email;",
        "options": {}
      }
    },
    {
      "id": "62a5162a-7a3a-4be7-a85a-f33b19a57220",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst SECRET = $('Get HMAC Secret').first().json.value;\nfunction sign(id, action) { return crypto.createHmac('sha256', SECRET).update('linkedin_post:' + id + ':' + action).digest('hex').slice(0, 32); }\nconst q = ($('Webhook (post approval)').item.json.query) || {};\nconst id = q.id;\nconst action = q.action;\nconst sig = q.sig || '';\nconst idOk = typeof id === 'string' && /^[0-9]+$/.test(id);\nconst actionOk = action === 'approve' || action === 'reject';\nlet sigOk = false;\nif (idOk && actionOk) {\n  const expected = sign(id, action);\n  const a = Buffer.from(String(sig));\n  const b = Buffer.from(expected);\n  sigOk = a.length === b.length && crypto.timingSafeEqual(a, b);\n}\nconst valid = idOk && actionOk && sigOk;\nreturn [{ json: { valid: valid, id: idOk ? id : '', action: actionOk ? action : '' } }];"
      }
    },
    {
      "id": "a81bb8f6-dcf0-4f16-b32a-8b50ac8895e9",
      "name": "Signature Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        672,
        240
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "1adc8eb3-e037-49fa-ac0b-121db0d4ad6d",
