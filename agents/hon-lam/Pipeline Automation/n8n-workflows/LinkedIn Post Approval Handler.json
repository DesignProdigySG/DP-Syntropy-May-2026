    {
      "id": "0cf34bf5-7235-416f-ad9c-fd7f5309a6a2",
      "name": "Build Publish Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const row = $json;\nconst NL = String.fromCharCode(10);\nconst subject = 'Approved — post to LinkedIn' + (row.account ? (' (' + row.account + ')') : '');\nconst parts = [];\nparts.push('This LinkedIn post was approved. Please publish it to LinkedIn:');\nparts.push('');\nparts.push(row.post_body || '');\nif (row.tracked_url) parts.push('Include this link: ' + row.tracked_url);\nparts.push('');\nparts.push('(Optional) reply with the live post URL so its engagement can be tracked.');\nreturn [{ json: { subject: subject, message: parts.join(NL) } }];"
      }
    },
