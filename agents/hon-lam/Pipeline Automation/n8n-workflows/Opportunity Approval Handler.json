  {
   "id": "afd5f3a6-dfd5-42a4-81bd-f65933e6c28c",
   "name": "Verify Signature",
   "type": "n8n-nodes-base.code",
   "position": [
    224,
    336
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const crypto = require('crypto');\nconst SECRET = $('Get HMAC Secret').first().json.value;\nfunction sign(id, action) {\n  return crypto.createHmac('sha256', SECRET).update(`opportunity:${id}:${action}`).digest('hex').slice(0, 32);\n}\nconst q = ($('Webhook (opportunity approve/reject)').first().json.query) || {};\nconst id = q.id;\nconst action = q.action;\nconst sig = q.sig || '';\nconst idOk = typeof id === 'string' && /^[0-9]+$/.test(id);\nconst actionOk = action === 'approve' || action === 'reject';\nlet sigOk = false;\nif (idOk && actionOk) {\n  const expected = sign(id, action);\n  const a = Buffer.from(String(sig));\n  const b = Buffer.from(expected);\n  sigOk = a.length === b.length && crypto.timingSafeEqual(a, b);\n}\nconst valid = idOk && actionOk && sigOk;\nreturn [{ json: { valid, query: { id: idOk ? id : '', action: actionOk ? action : '' } } }];",
    "language": "javaScript"
   },
   "typeVersion": 2
  },
  {
   "id": "7bef1523-7f0b-4e7d-acbb-896514b96e07",
