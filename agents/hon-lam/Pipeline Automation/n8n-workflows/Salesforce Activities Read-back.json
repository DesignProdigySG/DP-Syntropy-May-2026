{
  "name": "Salesforce Activities Read-back",
  "nodes": [
    {
      "id": "7f77655e-cd24-4456-80ef-90a275b1b38d",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -480,
