  {
   "id": "3204f9e5-f3f1-4899-af95-066dbd997154",
   "name": "Get Active Leads",
   "type": "n8n-nodes-base.postgres",
   "position": [
    -240,
    -80
   ],
   "parameters": {
    "query": "SELECT salesforce_lead_id, account, contact_name FROM salesforce_leads;",
    "options": {},
    "operation": "executeQuery"
   },
   "credentials": {
    "postgres": {
     "id": "eR1uo2QGR2ZzwysA",
     "name": "Postgres account"
    }
   },
   "typeVersion": 2.6
  },
  {
   "id": "c89f40fa-ff5e-4991-b7f2-ef01c87a4313",
   "name": "Build SOQL Queries",
   "type": "n8n-nodes-base.code",
   "position": [
    0,
    -80
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const leads = $input.all().map(i => i.json);\nconst leadMap = {};\nconst ids = [];\nfor (const l of leads) {\n  const id = String(l.salesforce_lead_id || '').replace(/[^a-zA-Z0-9]/g, '');\n  if (!id) continue;\n  ids.push(id);\n  leadMap[id] = { account: l.account || '', contact_name: l.contact_name || '' };\n}\nif (ids.length === 0) return [];\nconst idList = ids.map(id => \"'\" + id + \"'\").join(',');\nconst cutoff = new Date(Date.now() - 3 * 24 * 60 * 60 * 1000).toISOString();\nconst taskQuery = `SELECT Id, WhoId, Subject, ActivityDate, Description, Status, CreatedDate FROM Task WHERE WhoId IN (${idList}) AND CreatedDate >= ${cutoff}`;\nconst eventQuery = `SELECT Id, WhoId, Subject, ActivityDateTime, Description, CreatedDate FROM Event WHERE WhoId IN (${idList}) AND CreatedDate >= ${cutoff}`;\nreturn [{ json: { taskQuery, eventQuery, leadMap } }];"
   },
   "executeOnce": false,
   "typeVersion": 2
  },
  {
   "id": "3d257495-26e5-4157-912f-96b19519e400",
   "name": "Query Tasks",
   "type": "n8n-nodes-base.salesforce",
   "onError": "continueRegularOutput",
   "maxTries": 3,
   "position": [
    260,
    -200
   ],
   "parameters": {
    "query": "={{ $json.taskQuery }}",
    "resource": "search",
    "operation": "query"
   },
   "credentials": {
    "salesforceOAuth2Api": {
     "id": "HPnx6HXN8COY4aOe",
     "name": "Salesforce account 2"
    }
   },
   "retryOnFail": true,
   "typeVersion": 1.1,
   "waitBetweenTries": 2000
  },
  {
   "id": "ffbb7377-bc57-4de7-a3b7-6b801d6dda01",
   "name": "Combine Activities",
   "type": "n8n-nodes-base.merge",
   "position": [
    520,
    -80
   ],
   "parameters": {
    "mode": "append"
   },
   "typeVersion": 3.2
  },
  {
