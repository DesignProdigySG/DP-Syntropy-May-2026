    {
      "id": "3204f9e5-f3f1-4899-af95-066dbd997154",
      "name": "Get Active Leads",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -240,
        -80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT salesforce_lead_id, account, contact_name FROM salesforce_leads;",
        "options": {}
      }
    },
    {
      "id": "c89f40fa-ff5e-4991-b7f2-ef01c87a4313",
      "name": "Build SOQL Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const leads = $input.all().map(i => i.json);\nconst leadMap = {};\nconst ids = [];\nfor (const l of leads) {\n  const id = String(l.salesforce_lead_id || '').replace(/[^a-zA-Z0-9]/g, '');\n  if (!id) continue;\n  ids.push(id);\n  leadMap[id] = { account: l.account || '', contact_name: l.contact_name || '' };\n}\nif (ids.length === 0) return [];\nconst idList = ids.map(id => \"'\" + id + \"'\").join(',');\nconst cutoff = new Date(Date.now() - 3 * 24 * 60 * 60 * 1000).toISOString();\nconst taskQuery = `SELECT Id, WhoId, Subject, ActivityDate, Description, Status, CreatedDate FROM Task WHERE WhoId IN (${idList}) AND CreatedDate >= ${cutoff}`;\nconst eventQuery = `SELECT Id, WhoId, Subject, ActivityDateTime, Description, CreatedDate FROM Event WHERE WhoId IN (${idList}) AND CreatedDate >= ${cutoff}`;\nreturn [{ json: { taskQuery, eventQuery, leadMap } }];"
      },
      "executeOnce": false
    },
    {
      "id": "3d257495-26e5-4157-912f-96b19519e400",
      "name": "Query Tasks",
      "type": "n8n-nodes-base.salesforce",
      "typeVersion": 1.1,
      "position": [
        260,
        -200
      ],
      "parameters": {
        "resource": "search",
        "operation": "query",
        "query": "={{ $json.taskQuery }}"
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "ffbb7377-bc57-4de7-a3b7-6b801d6dda01",
      "name": "Combine Activities",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        520,
        -80
      ],
      "parameters": {
        "mode": "append"
      }
    },
    {
      "id": "7e32bb5a-33af-4859-a96f-a0123b2a3363",
      "name": "Query Events",
      "type": "n8n-nodes-base.salesforce",
      "typeVersion": 1.1,
      "position": [
        260,
        40
      ],
      "parameters": {
        "resource": "search",
        "operation": "query",
        "query": "={{ $json.eventQuery }}"
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "7098fb2a-6942-4e6c-932f-3aa9816c4a4a",
      "name": "Map To Engagement Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        -80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const leadMap = $('Build SOQL Queries').first().json.leadMap || {};\nconst items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const item = it.json;\n  const attrs = item.attributes || {};\n  const sfType = attrs.type === 'Event' ? 'Event' : 'Task';\n  const who = leadMap[item.WhoId];\n  if (!who) continue;\n  const occurredAt = sfType === 'Event' ? item.ActivityDateTime : (item.ActivityDate || item.CreatedDate);\n  const metadata = JSON.stringify({ sf_type: sfType, subject: item.Subject || '', status: item.Status || '', description: item.Description || '' });\n  out.push({ json: { account: who.account, contact_name: who.contact_name, salesforce_activity_id: item.Id, occurred_at: occurredAt, metadata } });\n}\nreturn out;"
      }
    },
    {
      "id": "b7932452-b10b-491c-824d-b9aac6a01653",
      "name": "Insert Engagement Event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1000,
        -80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO engagement_events (account, contact, source, event_type, salesforce_activity_id, occurred_at, metadata)\nSELECT '{{ $json.account.replace(/'/g, \"''\") }}',\n       '{{ $json.contact_name.replace(/'/g, \"''\") }}',\n       'salesforce', 'crm_activity',\n       '{{ $json.salesforce_activity_id }}',\n       '{{ $json.occurred_at }}'::timestamptz,\n       '{{ $json.metadata.replace(/'/g, \"''\") }}'::jsonb\nWHERE NOT EXISTS (SELECT 1 FROM engagement_events WHERE salesforce_activity_id = '{{ $json.salesforce_activity_id }}');",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "d08ee28d-0f3d-4ea5-97a4-aac35ab68100",
      "name": "SF Sync Error?",
