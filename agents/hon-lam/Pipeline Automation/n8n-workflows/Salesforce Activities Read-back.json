   "name": "Query Events",
   "type": "n8n-nodes-base.salesforce",
   "onError": "continueRegularOutput",
   "maxTries": 3,
   "position": [
    260,
    40
   ],
   "parameters": {
    "query": "={{ $json.eventQuery }}",
    "resource": "search",
    "operation": "query"
   },
   "credentials": {
    "salesforceOAuth2Api": {
     "id": "HPnx6HXN8COY4aOe",
     "name": "Salesforce account 2"
    }
   },
