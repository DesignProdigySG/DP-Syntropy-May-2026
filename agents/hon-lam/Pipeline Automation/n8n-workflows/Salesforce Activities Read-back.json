  {
   "id": "7098fb2a-6942-4e6c-932f-3aa9816c4a4a",
   "name": "Map To Engagement Event",
   "type": "n8n-nodes-base.code",
   "position": [
    760,
    -80
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const leadMap = $('Build SOQL Queries').first().json.leadMap || {};\nconst items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const item = it.json;\n  const attrs = item.attributes || {};\n  const sfType = attrs.type === 'Event' ? 'Event' : 'Task';\n  const who = leadMap[item.WhoId];\n  if (!who) continue;\n  const occurredAt = sfType === 'Event' ? item.ActivityDateTime : (item.ActivityDate || item.CreatedDate);\n  const metadata = JSON.stringify({ sf_type: sfType, subject: item.Subject || '', status: item.Status || '', description: item.Description || '' });\n  out.push({ json: { account: who.account, contact_name: who.contact_name, salesforce_activity_id: item.Id, occurred_at: occurredAt, metadata } });\n}\nreturn out;"
   },
   "typeVersion": 2
  },
  {
   "id": "b7932452-b10b-491c-824d-b9aac6a01653",
   "name": "Insert Engagement Event",
   "type": "n8n-nodes-base.postgres",
   "onError": "continueRegularOutput",
   "position": [
    1000,
    -80
   ],
   "parameters": {
    "query": "INSERT INTO engagement_events (account, contact, source, event_type, salesforce_activity_id, occurred_at, metadata)\nSELECT '{{ $json.account.replace(/'/g, \"''\") }}',\n       '{{ $json.contact_name.replace(/'/g, \"''\") }}',\n       'salesforce', 'crm_activity',\n       '{{ $json.salesforce_activity_id }}',\n       '{{ $json.occurred_at }}'::timestamptz,\n       '{{ $json.metadata.replace(/'/g, \"''\") }}'::jsonb\nWHERE NOT EXISTS (SELECT 1 FROM engagement_events WHERE salesforce_activity_id = '{{ $json.salesforce_activity_id }}');",
    "options": {},
    "operation": "executeQuery"
   },
   "credentials": {
    "postgres": {
     "id": "eR1uo2QGR2ZzwysA",
     "name": "Postgres account"
    }
   },
