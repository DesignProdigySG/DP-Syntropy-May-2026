  {
   "id": "15c50f7b-2c98-4a9a-9d10-b5008cb36f70",
   "name": "Get Measured Outcomes",
   "type": "n8n-nodes-base.postgres",
   "position": [
    224,
    0
   ],
   "parameters": {
    "query": "SELECT o.action_id, a.salesforce_task_id, a.account, a.action_type, a.reason, a.hypothesis, a.tracked_url,\n       o.result, o.measured_metric, o.measured_value, o.baseline_value, o.effect, o.measured_at\nFROM outcomes o\nJOIN actions a ON a.id = o.action_id\nWHERE a.salesforce_task_id IS NOT NULL\n  AND o.measured_at > now() - interval '1 day'\nORDER BY o.measured_at DESC\nLIMIT 100;",
    "options": {},
    "operation": "executeQuery"
   },
   "credentials": {
    "postgres": {
     "id": "eR1uo2QGR2ZzwysA",
     "name": "Postgres account"
    }
   },
   "typeVersion": 2.6
  },
  {
   "id": "19df25f4-336c-4d8b-bc2b-6968d14446bd",
   "name": "Build Task Update",
   "type": "n8n-nodes-base.code",
   "position": [
    448,
    0
   ],
   "parameters": {
    "mode": "runOnceForEachItem",
    "jsCode": "// Rebuild the Task description in the same shape 'Create a task' wrote it,\n// with the measured outcome appended — Salesforce Task update replaces the\n// description wholesale, so we reconstruct rather than append blind.\nconst j = $json;\nconst label = j.result === 'met' ? 'MET \\u2713' : (j.result === 'not_met' ? 'NOT MET \\u2717' : 'INCONCLUSIVE');\nconst description = [\n  j.reason || '',\n  '',\n  `Hypothesis: ${j.hypothesis || ''}`,\n  `Tracked link: ${j.tracked_url || ''}`,\n  '',\n  `--- OUTCOME (synced from DP Syntropy ${String(j.measured_at).slice(0, 10)}) ---`,\n  `Result: ${label}`,\n  `${j.measured_metric || 'metric'}: ${j.measured_value ?? 'n/a'} vs baseline ${j.baseline_value ?? 'n/a'} (effect ${j.effect ?? 'n/a'})`\n].join('\\n');\nreturn { json: { taskId: j.salesforce_task_id, description } };"
   },
   "typeVersion": 2
  },
  {
   "id": "0ba95ca6-57df-4607-874c-9080ffa04b6f",
   "name": "Complete Salesforce Task",
   "type": "n8n-nodes-base.salesforce",
   "onError": "continueRegularOutput",
   "maxTries": 3,
   "position": [
    672,
    0
   ],
   "parameters": {
    "taskId": "={{ $json.taskId }}",
    "resource": "task",
    "operation": "update",
    "updateFields": {
     "status": "Completed",
     "description": "={{ $json.description }}"
    }
   },
   "credentials": {
    "salesforceOAuth2Api": {
     "id": "HPnx6HXN8COY4aOe",
     "name": "Salesforce account 2"
    }
   },
   "retryOnFail": true,
