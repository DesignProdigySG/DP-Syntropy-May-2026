{
  "name": "Salesforce Task Outcome Sync",
  "nodes": [
    {
      "id": "c99671c8-797c-42d3-ae67-5a52d499e10e",
      "name": "Daily 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
