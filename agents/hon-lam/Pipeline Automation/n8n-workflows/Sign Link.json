    {
      "id": "e37982ef-d214-4094-b3d7-f3f48f8d4cb0",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = ($('Webhook (sign link)').first().json.body) || {};\n// Batch mode: {items:[{scope,id,action},...]} — the dashboards send one request per tab load.\n// Single mode: {scope,id,action} still accepted for backwards compatibility.\nconst raw = Array.isArray(body.items) ? body.items : [{ scope: body.scope, id: body.id, action: body.action }];\nconst items = [];\nfor (const it of raw.slice(0, 500)) {\n  const scope = it && it.scope;\n  const id = it && it.id;\n  const action = it && it.action;\n  const ok = ['brief','action','opportunity'].includes(scope)\n    && (typeof id === 'string' || typeof id === 'number') && /^[0-9]+$/.test(String(id))\n    && (action === 'approve' || action === 'reject');\n  if (ok) items.push({ scope, id: String(id), action });\n}\nreturn [{ json: { valid: items.length > 0, items } }];"
      }
    },
    {
      "id": "4e18e44f-95ad-43e8-86fb-64fe2066b8d9",
      "name": "Build HMAC Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const crypto = require('crypto');\nconst SECRET = $json.value;\nconst v = $('Validate Request').first().json;\nconst sigs = v.items.map(it => ({ scope: it.scope, id: it.id, action: it.action, sig: crypto.createHmac('sha256', SECRET).update(`${it.scope}:${it.id}:${it.action}`).digest('hex').slice(0, 32) }));\nreturn [{ json: { sigs } }];"
      }
    },
