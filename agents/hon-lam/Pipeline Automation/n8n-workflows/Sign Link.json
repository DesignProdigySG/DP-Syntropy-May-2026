    {"id":"21b8570e-caaf-4785-942f-b003002fc85c","name":"Build Signature","type":"n8n-nodes-base.code","typeVersion":2,"position":[448,96],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const crypto = require('crypto');\nconst SECRET = $('Get HMAC Secret').first().json.value;\nconst body = ($('Webhook (sign link)').first().json.body) || {};\nconst scope = body.scope;\nconst id = body.id;\nconst action = body.action;\nconst scopeOk = ['brief','action','opportunity'].includes(scope);\nconst idOk = (typeof id === 'string' || typeof id === 'number') && /^[0-9]+$/.test(String(id));\nconst actionOk = action === 'approve' || action === 'reject';\nconst valid = scopeOk && idOk && actionOk;\nlet sig = null;\nif (valid) {\n  sig = crypto.createHmac('sha256', SECRET).update(`${scope}:${id}:${action}`).digest('hex').slice(0, 32);\n}\nreturn [{ json: { valid, sig, scope: scopeOk ? scope : '', id: idOk ? String(id) : '', action: actionOk ? action : '' } }];"}},
