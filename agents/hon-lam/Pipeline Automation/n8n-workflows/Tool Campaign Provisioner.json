   "position": [
    1568,
    0
   ],
   "parameters": {
    "query": "UPDATE actions SET tool_campaign_id = '{{ $('Create Smartlead Campaign').item.json.id }}' WHERE id = {{ $('Prepare Items').item.json.action_id }} AND tool_campaign_id IS NULL RETURNING id, tool_campaign_id;",
    "options": {},
    "operation": "executeQuery"
   },
   "credentials": {
    "postgres": {
