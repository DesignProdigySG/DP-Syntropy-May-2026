   "position": [
    672,
    0
   ],
   "parameters": {
    "query": "SELECT id, utm_campaign, account, target, outreach_draft, tracked_url FROM actions WHERE action_type = 'email' AND status IN ('recommended','approved','executed') AND tool_campaign_id IS NULL AND utm_campaign IS NOT NULL ORDER BY id LIMIT 20;",
    "options": {},
    "operation": "executeQuery"
   },
   "credentials": {
    "postgres": {
     "id": "eR1uo2QGR2ZzwysA",
     "name": "Postgres account"
    }
   },
   "typeVersion": 2.6
  },
  {
   "id": "dcb60101-1217-4fcb-ac62-87c8df4df24c",
   "name": "Prepare Items",
   "type": "n8n-nodes-base.code",
   "position": [
    896,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const key = ($('Get Smartlead Key').first().json.value || '').trim();\nreturn $input.all().map(i => ({ json: { action_id: i.json.id, utm_campaign: i.json.utm_campaign, account: i.json.account, target: i.json.target || '', outreach_draft: i.json.outreach_draft || '', tracked_url: i.json.tracked_url || '', api_key: key } }));"
   },
   "typeVersion": 2
  },
  {
   "id": "3cf3cd66-f632-40b2-a25d-d25a9525530e",
   "name": "Create Smartlead Campaign",
   "type": "n8n-nodes-base.httpRequest",
   "position": [
    1120,
    0
   ],
   "parameters": {
    "url": "=https://server.smartlead.ai/api/v1/campaigns/create?api_key={{ $json.api_key }}",
    "method": "POST",
    "options": {
     "batching": {
      "batch": {
       "batchSize": 1,
       "batchInterval": 1500
      }
     }
    },
    "jsonBody": "={{ JSON.stringify({ name: $json.utm_campaign }) }}",
    "sendBody": true,
    "contentType": "json",
    "specifyBody": "json"
   },
   "typeVersion": 4.3
  },
  {
