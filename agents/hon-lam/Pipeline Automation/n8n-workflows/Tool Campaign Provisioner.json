    "jsonBody": "{\"id\": null, \"name\": \"DP engagement feeder\", \"webhook_url\": \"https://designprodigy.app.n8n.cloud/webhook/email-events\", \"event_types\": [\"EMAIL_OPENED\", \"EMAIL_CLICKED\", \"EMAIL_REPLIED\"], \"categories\": []}",
    "sendBody": true,
    "contentType": "json",
    "specifyBody": "json"
   },
   "typeVersion": 4.3
  },
  {
   "id": "f7b5c210-4e5c-46f6-9083-cb4b52beeb7b",
