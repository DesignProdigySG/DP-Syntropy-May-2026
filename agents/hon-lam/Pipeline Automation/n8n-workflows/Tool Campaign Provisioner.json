  {
   "id": "4c76733e-0e15-42bb-b396-90516f0fa60a",
   "name": "Provisioning Summary",
   "type": "n8n-nodes-base.gmail",
   "position": [
    1792,
    0
   ],
   "webhookId": "307712eb-99cc-4616-bd97-3e11630e7d2f",
   "parameters": {
    "sendTo": "honlamchia@gmail.com",
    "message": "=Tool Campaign Provisioner run complete.\n\nProvisioned {{ $('Prepare Items').all().length }} Smartlead campaign(s), one per pending email action, each named as its utm_campaign with the engagement webhook attached (EMAIL_OPENED / EMAIL_CLICKED / EMAIL_REPLIED -> /webhook/email-events).\n\nWhere the action's target was a real email address AND an outreach draft existed, the campaign was also fully auto-enrolled: draft saved as the email sequence, SGT business-hours schedule set, lead added, campaign STARTED (zero-touch send).\n\nActions: {{ $('Prepare Items').all().map(i => i.json.account + ' (' + i.json.utm_campaign + (String(i.json.target).includes('@') ? ', auto-enrolled: ' + i.json.target : ', no contact email — rep sends manually') + ')').join('; ') }}",
    "options": {},
    "subject": "=Smartlead provisioning — {{ $('Prepare Items').all().length }} campaign(s) created",
    "resource": "message",
    "emailType": "text",
    "operation": "send"
   },
   "credentials": {
    "gmailOAuth2": {
     "id": "vKMX1dZQWsi80BVz",
     "name": "Gmail OAuth2 API"
    }
   },
   "executeOnce": true,
   "typeVersion": 2.2
  },
  {
   "id": "dad45515-de05-44d9-9bb6-edf4af2f7b3d",
